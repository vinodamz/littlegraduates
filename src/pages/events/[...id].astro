---
import Base from '../../layouts/Base.astro';
import EventClock from '../../components/EventClock.astro';
import EventPhoto from '../../components/EventPhoto.astro';
import EventRegister from '../../components/EventRegister.astro';
import { eventEndsAtIso, eventJsonLd, formatEventDate, isPast } from '../../data/events';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const { Content } = await render(event);
const past = isPast(event.data);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = eventJsonLd(event.data, pageUrl);
const description = event.data.seoDescription || event.data.excerpt || `${event.data.title} at ${event.data.location}.`;
const whenDate = formatEventDate(event.data.start);
const kicker = past ? 'Past event' : event.data.public ? 'Open to the public' : 'Event';
---
<Base
  title={`${event.data.title} - The Little Graduates`}
  description={description}
  image={event.data.image || undefined}
  imageWidth={event.data.imageWidth}
  imageHeight={event.data.imageHeight}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <article class="event-detail" data-ends={past ? undefined : eventEndsAtIso(event.data)}>
    <section class="page-band teal event-band">
      <div class="container">
        <span class="kicker teal">{kicker}</span>
        <h1>{event.data.title}</h1>
        <p class="lead event-when"><span class="event-when-date">{whenDate}</span>{event.data.time && <span class="event-when-time">{event.data.time}</span>}</p>
        <p class="meta">{event.data.location}</p>
      </div>
    </section>
    <section class="section tight">
      <div class:list={['container', { 'event-feature': Boolean(event.data.image) }]}>
        {event.data.image && (
          <EventPhoto
            class="event-feature-photo"
            src={event.data.image}
            alt={event.data.imageAlt || event.data.title}
            width={event.data.imageWidth}
            height={event.data.imageHeight}
            srcset={event.data.imageSrcset}
            sizes="(max-width: 760px) calc(100vw - 3rem), 380px"
            eager
          />
        )}
        <div class="prose">
        <Content />
        {event.data.landing && <p class="event-share"><a href={event.data.landing}>Shareable invitation page</a></p>}
        {!past && event.data.registrationUrl && (
          <EventRegister href={event.data.registrationUrl} detailsHref="/events/" detailsLabel="All events" large formNote />
        )}
        {past && <p class="past-note">This event has passed.</p>}
        {!past && <p class="past-note" data-past-note hidden>This event has passed.</p>}
        {past && <p class="event-back"><a class="btn btn-outline" href="/events/">All events</a></p>}
        </div>
      </div>
    </section>
  </article>
  <EventClock />
</Base>
