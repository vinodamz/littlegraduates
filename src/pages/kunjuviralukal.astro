---
import Base from '../layouts/Base.astro';
import EventClock from '../components/EventClock.astro';
import EventPhoto from '../components/EventPhoto.astro';
import EventRegister from '../components/EventRegister.astro';
import InstagramReel from '../components/InstagramReel.astro';
import { eventEndsAtIso, eventJsonLd, isPast } from '../data/events';
import { getCollection } from 'astro:content';

const event = (await getCollection('events')).find((item) => item.id === 'kunjuviralukal-let-me-be-little');
if (!event) throw new Error('Missing Kunjuviralukal event content');
const past = isPast(event.data);
const pageUrl = new URL('/kunjuviralukal/', Astro.site).href;
const shareDescription = 'Tiny fingers. Big colours. Endless fun! Arts & Crafts Festival, Saturday 21 November 2026, 3:00 to 6:00 pm at The Little Graduates, Kaloor.';
const schema = eventJsonLd({ ...event.data, seoDescription: shareDescription }, pageUrl);
---
<Base
  title={`${event.data.title} - The Little Graduates`}
  description={shareDescription}
  image={event.data.image || undefined}
  imageWidth={event.data.imageWidth}
  imageHeight={event.data.imageHeight}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <article class="invite-page" data-ends={past ? undefined : eventEndsAtIso(event.data)}>
    <section class="invite-lead">
      <div class="container invite-copy">
        <p class="invite-hook">Tiny fingers. Big colours. Endless fun! 🎨</p>
        <p class="invite-malayalam">കുഞ്ഞുവിരലുകൾ</p>
        <h1>Let me be little!!</h1>
        <ul class="invite-facts">
          <li>Arts &amp; Crafts Festival</li>
          <li>Saturday 21 November 2026, 3:00 to 6:00 pm</li>
          <li>The Little Graduates, Kaloor, Kochi</li>
          <li>Open to all little ones</li>
          <li>Art and craft, celebrating creativity and self-expression</li>
        </ul>
        {!past && event.data.registrationUrl && (
          <div class="invite-actions" data-register>
            <EventRegister href={event.data.registrationUrl} large />
          </div>
        )}
      </div>
    </section>
    {event.data.image && (
      <figure class="invite-hero">
        <EventPhoto
          class="invite-hero-photo"
          src={event.data.image}
          alt={event.data.imageAlt || event.data.title}
          width={event.data.imageWidth}
          height={event.data.imageHeight}
          srcset={event.data.imageSrcset}
          sizes="(max-width: 760px) calc(100vw - 3rem), 720px"
        />
      </figure>
    )}
    <section class="section tight invite-more">
      <div class="container invite-copy">
        {event.data.instagram && <InstagramReel permalink={event.data.instagram} title={`${event.data.title} on Instagram`} />}
        {!past && event.data.registrationUrl && (
          <div class="invite-actions">
            <EventRegister href={event.data.registrationUrl} large />
          </div>
        )}
        {past && <p class="past-note">This event has passed.</p>}
        {!past && <p class="past-note" data-past-note hidden>This event has passed.</p>}
      </div>
    </section>
  </article>
  <EventClock />
</Base>
