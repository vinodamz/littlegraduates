---
import Base from '../layouts/Base.astro';
import AdmissionsJourney from '../components/AdmissionsJourney.astro';
import { faqSchema } from '../data/seasonal';
---
<Base title="Preschool in Kaloor, Kochi | The Little Graduates" description="A gentle beginning for ages 1.5–6. Explore Montessori preschool learning in Kaloor, Kochi, ask about admissions or book a free campus visit." admissionsJourney={true}>
<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<link slot="head" rel="preload" as="image" href="/media/hero/campus.webp" type="image/webp" fetchpriority="high" />
<AdmissionsJourney seasonal={false} />
</Base>
